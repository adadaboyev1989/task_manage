# Server
PORT=3000
APP_URL=https://your-domain.example
TZ=Asia/Tashkent
ENVIRONMENT=production

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Telegram bot — create one with @BotFather on Telegram, then paste its token & username here.
# Leave both empty for local development: a "dev login" panel appears on /login instead.
BOT_TOKEN=
BOT_USERNAME=

# Web Push (PWA notifications) — generate with: python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Storage paths (defaults are fine for most deployments)
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
